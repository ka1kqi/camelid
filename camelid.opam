# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Typed OCaml client for the Alpaca trading and market-data APIs"
description:
  "Account, positions, orders, market clock and latest-trade endpoints for Alpaca (paper and live). Pure JSON decoders, a pluggable HTTP transport, and a ready-made Eio + cohttp-eio + ocaml-tls HTTPS transport."
maintainer: ["camelid contributors"]
authors: ["camelid contributors"]
license: "MIT"
tags: ["alpaca" "trading" "finance" "brokerage" "eio"]
homepage: "https://github.com/ka1kqi/camelid"
bug-reports: "https://github.com/ka1kqi/camelid/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.0" & >= "3.0"}
  "yojson" {>= "2.0"}
  "uri"
  "domain-name"
  "eio" {>= "1.0"}
  "cohttp-eio" {>= "6.0"}
  "tls-eio" {>= "1.0"}
  "ca-certs"
  "mirage-crypto-rng"
  "eio_main" {with-test}
  "ppx_expect" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ka1kqi/camelid.git"
